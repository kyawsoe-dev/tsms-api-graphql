# Server
PORT=3000

# PostgreSQL connection string (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/task_management_db?schema=public"

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS (comma separated origins, or * for all)
CORS_ORIGIN=http://localhost:4000,http://localhost:3001

# Optional: GraphQL playground toggle
GRAPHQL_PLAYGROUND=true

# Rate limiting (per IP per ttl seconds, applied to all HTTP GraphQL operations)
# NOTE: set `trust proxy` on the Express app when running behind a reverse
# proxy so throttling keys on the real client IP instead of the proxy's.
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Optional: Swagger / OpenAPI docs
SWAGGER_ENABLED=true
SWAGGER_PATH=/docs
